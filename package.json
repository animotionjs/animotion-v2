{
	"name": "@animotion/core",
	"version": "0.0.1",
	"description": "A Svelte engine for building animated presentations.",
	"keywords": [
		"svelte",
		"slides",
		"presentation",
		"animation"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/animotionjs/animotion-v2.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles/code-theme.css": "./dist/styles/code-theme.css"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"bin": {
		"animotion": "./src/cli/render.ts"
	},
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"src/cli",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/config/**"
	],
	"engines": {
		"node": ">=23.6.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"render": "node src/cli/render.ts",
		"package": "svelte-package",
		"prepack": "pnpm package",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"ffmpeg-static"
		]
	},
	"devDependencies": {
		"@codemirror/language": "^6.12.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "next",
		"@sveltejs/kit": "next",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.1",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@lezer/common": "^1.5.2",
		"@lezer/highlight": "^1.2.3",
		"@lezer/javascript": "^1.5.4",
		"@lezer/lr": "^1.4.10",
		"ffmpeg-static": "^5.3.0",
		"playwright": "^1.61.1"
	}
}

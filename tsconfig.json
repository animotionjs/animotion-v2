{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"paths": {
			"#lib": ["./src/lib/index.js"],
			"#lib/*": ["./src/lib/*"],
			"$app/types": ["./.svelte-kit/types/index.d.ts"]
		}
	},
	"include": ["src", "*.ts", "*.js"]
}
